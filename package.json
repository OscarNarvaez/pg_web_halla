{
  "name": "halla",
  "private": true,
  "version": "0.1.0",
  "description": "Sistema experto de clasificación y redacción de hallazgos de auditoría interna en salud",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "ingest": "node scripts/ingest-normas.mjs",
    "ingest:dry": "node scripts/ingest-normas.mjs --dry-run",
    "verificar-rls": "node scripts/verificar-rls.mjs",
    "probar:bd": "node scripts/probar-bd.mjs",
    "probar:busqueda": "node scripts/probar-busqueda.mjs",
    "probar:validacion": "node scripts/probar-validacion.mjs",
    "probar:motor": "node scripts/probar-motor.mjs",
    "probar:gemini": "node scripts/probar-gemini.mjs",
    "verificar:prompt": "node scripts/verificar-prompt.mjs",
    "probar": "node scripts/verificar-prompt.mjs && node scripts/probar-validacion.mjs && node scripts/probar-gemini.mjs && node scripts/probar-bd.mjs && node scripts/probar-busqueda.mjs",
    "check:funciones": "cd supabase/functions && pnpm dlx deno check clasificar-hallazgo/index.ts completar-auditoria/index.ts generar-informe/index.ts",
    "probar:interfaz": "node scripts/probar-interfaz.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.117.2",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "file-saver": "^2.0.5",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.50.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.2"
  }
}
